* {
    negro: #191919f0;
    gris: #404040;
    gris-m: #565656cd;
    gris-cl: #d0d0d0;
    tinto: #7f0000;
    rojo1: #bd0003;
    rojo2: #cd0c36;
    trans1: #00000001;

    bg-window: rgba(35, 35, 35, 0.9);
    bg-card: rgba(35, 30, 45, 0.8);
    bg-hover: rgba(70, 70, 70, 0.8);
    bg-hover2: rgba(90, 90, 90, 0.7);

    accent-primary: rgba(100, 114, 120, 0.5);
    accent-secondary: #ee3333;
    accent-warm: #ff8c00;

    text-main: #ffffff;
    text-dim: #b0b0b0;

    critical-bg: #cc241d;
    warning-bg: #fabd2f;


    border-radius: 8px;
    font: "JetBrainsMono Nerd Font 12";
}


/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       500px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border-radius:               10px;
    cursor:                      "default";
    background-color:            @bg-hover2;
    border-color:                @accent-primary;
    border:                      2px;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     15px;
    padding:                     30px;
    background-color:            @bg-window;
    children:                    [ "inputbar", "mode-switcher", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    background-color:            transparent;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    padding:                     12px 10px 12px 16px;
    border:                      0px;
    border-radius:               8px;
    border-color:                gray/30%;
    border-color:                @accent-primary;
    background-color:            @gris-m;
    text-color:                  @text-main;
    str:                         " ";
}
entry {
    enabled:                     true;
    padding:                     12px 16px;
    border:                      1px;
    border-radius:               8px;
    border-color:                gray/30%;
    background-color:            @gris-m;
    text-color:                  @text-main;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     10px;
    background-color:            transparent;
    cursor:                      "default";
}



/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px solid;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @text-main;
    cursor:                      pointer;
}
element normal.active {
    background-image:            linear-gradient(to right, #19B466, #7BF4B7);
    text-color:                  @text-main;
}
element selected.normal {
    border-radius:               8px;
    background-image:            linear-gradient(to right, #b517e9, #d50000);
    text-color:                  black;
}
element selected.active {
    background-image:            linear-gradient(to right, #EA5553, #EAACAB);
    text-color:                  @text-main;
}
element-icon {
    background-color:            transparent;
    size:                        48px;
    cursor:                      inherit;
}
element-text {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}



/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    expand:                      false;
    spacing:                     15px;
    background-color:            transparent;
}
button {
    padding:                     10px;
    border-radius:               8px;
    background-image:            linear-gradient(to right, #b517e9, #f72585);
    text-color:                  white;
    cursor:                      pointer;
}
button selected {
    background-image:            linear-gradient(to right, #890000, #e50000);
    text-color:                  black;
}



/*****----- Message -----*****/
error-message {
    padding:                     20px;
    background-color:            white;
    text-color:                  black;
}
textbox {
    padding:                     0px;
    border-radius:               0px;
    text-color:                  black;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
